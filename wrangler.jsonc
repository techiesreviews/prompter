{
  // One Worker: static page from ./dist plus the MCP endpoint at /mcp and the
  // live connection to the open prompter tab at /api/*. Free plan only. No KV,
  // D1 or R2: no script is stored. Two Durable Object classes: the /mcp rate
  // limiter counts requests in memory per hashed client and never writes to
  // its storage (src/limiter.mjs); the relay keeps only a small note per agent
  // token ({ createdAt, expiresAt, revoked, agent }) that an alarm erases, and
  // passes scripts through memory only (src/relay.mjs).
  "name": "techies-prompter",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "prompter.techies.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"],
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  // Per-client /mcp limit. The free plan only offers SQLite-backed Durable
  // Objects; the limiter class still never reads or writes storage. (The Workers
  // rate-limiting binding was dropped: live tests showed it did not enforce.)
  // RELAY: one object per hashed agent token, between the agent and the tab.
  "durable_objects": {
    "bindings": [
      { "name": "MCP_LIMITER", "class_name": "McpLimiter" },
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["McpLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] }
  ],
  // No request logs: scripts must never be recorded.
  "observability": { "enabled": false },
  "build": { "command": "node scripts/build.mjs" }
}
