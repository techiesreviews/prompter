{
  // One Worker: static page from ./dist plus the stateless MCP endpoint at /mcp.
  // Free plan only. No KV, D1 or R2: nothing is stored. The one Durable Object
  // is the /mcp rate limiter: it counts requests in memory per hashed client
  // and never writes to its storage (see src/limiter.mjs).
  "name": "techies-prompter",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "prompter.techies.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/"],
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  // Per-client /mcp limit. The free plan only offers SQLite-backed Durable
  // Objects; the class still never reads or writes storage. (The Workers
  // rate-limiting binding was dropped: live tests showed it did not enforce.)
  "durable_objects": {
    "bindings": [{ "name": "MCP_LIMITER", "class_name": "McpLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpLimiter"] }],
  // No request logs: scripts must never be recorded.
  "observability": { "enabled": false },
  "build": { "command": "node scripts/build.mjs" }
}
